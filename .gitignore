# Environment / Secrets — NEVER commit real credentials (Checklist 7)
.env
.env.*
.env.local
.env.production
!.env.example

# Dependencies
/vendor/
/node_modules/

# Database dumps / sensitive scratch
*.sql
!backend/database/database.sql
!backend/database/room_availability_schema.sql
backend/logs/backups/*
backend/scratch/*
*.pem
*.key

# Logs
backend/logs/*.log
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Uploads / Dynamic generated QR codes & receipts
frontend/uploads/receipts/*
!frontend/uploads/receipts/.gitkeep
frontend/assets/qrcodes/*
!frontend/assets/qrcodes/.gitkeep

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
