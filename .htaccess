# ════════════════════════════════════════════════════════════════════════════════
#  Santa Fe Beach Club — Server Security & Dynamic Routing (.htaccess)
# ════════════════════════════════════════════════════════════════════════════════
# Disable Directory Listing & Hide Server Version Info (Checklist 6)
Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# Protect Sensitive & Configuration Files (Checklist 6)
<FilesMatch "^\.env|\.git|\.gitignore|composer\.(json|lock)|config\.php|database\.(php|sql)|\.log|\.md|\.ini|\.bak|\.sh$">
    Require all denied
</FilesMatch>

# Block access to hidden directories and files (e.g. .git/)
RewriteRule (^|/)\.(?!well-known/) - [F]

RewriteEngine On

# ── Force HTTPS in production (preserves local development) ───────────────────────
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Dynamic rewrite base / path routing ──────────────────────────────────────────

# Directly serve static assets (CSS, JS, images, etc.) from frontend/assets
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/(.+)$ frontend/assets/$1 [L]

# Directly serve uploaded receipts and photos
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/(.+)$ frontend/uploads/$1 [L]

# Directly serve backend endpoints if requested
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^backend/(.+)$ backend/$1 [L,QSA]

# Dynamic clean URL rewrite for root requests:
# e.g., /accommodations -> frontend/accommodations.php
# e.g., /admin_dashboard -> frontend/admin_dashboard.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^frontend/(.+)\.php$ frontend/$1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ frontend/$1.php [L,QSA]
