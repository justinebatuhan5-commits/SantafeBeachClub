# ============================================================
# Santa Fe Beach Club - Environment Variables EXAMPLE
# ============================================================
# Copy this file to .env and fill in your real values.
# The .env file is gitignored and must NEVER be committed.
# ============================================================

# Gmail SMTP Credentials
# Use a Gmail App Password (NOT your real Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the account.)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Display name shown in the "From" field of sent emails
MAIL_FROM_NAME=Santa Fe Beach Club

# Database Connection (Agila, Render, managed MySQL, or local XAMPP)
# Set all DB_* values in production using a newly rotated password.
# Leave DB_HOST empty only for local XAMPP auto-detection.
# Private receipts: absolute directory OUTSIDE Apache's DocumentRoot.
# Default on XAMPP: C:/xampp/SantaBeachClub-private
# On production, use a persistent directory writable by the PHP service account.
PRIVATE_STORAGE_DIR=
# Optional document root override for CLI migration / nonstandard hosting:
PRIVATE_STORAGE_DOCUMENT_ROOT=

DB_HOST=
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=
DB_PASS=

# Public URL for private guest payment links (no trailing slash).
PUBLIC_APP_URL=https://santafbeachclub.com
# Room holds expire after this duration, or at arrival time if earlier.
DISCOUNT_HOLD_HOURS=24
# Private IDs are deleted this many days after review/submission.
DISCOUNT_ID_RETENTION_DAYS=30

# PayMongo keys from your dashboard. Never commit real keys.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Refund phone MFA. Choose "twilio" for international SMS or "semaphore"
# for Philippine numbers. Leave SMS_PROVIDER blank to keep phone MFA safely unavailable.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SantaFe

# Optional absolute mysqldump path; defaults to XAMPP on Windows, /usr/bin/mysqldump on Linux.
BACKUP_MYSQLDUMP=

# PayMongo webhook signing secret from the webhook configuration (not an API key).
# Requests are rejected until this is configured. Never commit the real secret.
PAYMONGO_WEBHOOK_SECRET=


# Cloudinary Storage Credentials (for permanent image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional remote analytics service. Leave blank to use the authenticated native
# PHP analytics API. These values are server-only and must never be exposed in JS.
ANALYTICS_SERVICE_URL=
ANALYTICS_API_KEY=
# Set to true temporarily to prove that the dashboard is receiving analytics
# from Python. The dashboard returns HTTP 503 instead of falling back to PHP
# when Python is unavailable. Set back to false after verification.
ANALYTICS_REQUIRE_PYTHON=false
